{
  "manifest_version": "0.3",
  "name": "il-school-mcp",
  "display_name": "Israeli School (Mashov & Webtop)",
  "version": "0.2.0",
  "description": "Local read-only MCP extension for Israeli school portals (Mashov & Webtop)",
  "author": {
    "name": "Hagai Jacobson",
    "url": "https://github.com/hagaija/il-school-mcp"
  },
  "icon": "assets/logo.svg",
  "server": {
    "type": "node",
    "entry_point": "bundle/server.cjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/bundle/server.cjs"],
      "env": {
        "MASHOV_USERNAME": "${user_config.mashov_username}",
        "MASHOV_PASSWORD": "${user_config.mashov_password}",
        "MASHOV_SEMEL": "${user_config.mashov_semel}",
        "WEBTOP_USERNAME": "${user_config.webtop_username}",
        "WEBTOP_PASSWORD": "${user_config.webtop_password}"
      }
    }
  },
  "user_config": {
    "mashov_username": {
      "type": "string",
      "title": "Mashov Username / ID (optional)",
      "required": false
    },
    "mashov_password": {
      "type": "string",
      "title": "Mashov Password (optional)",
      "sensitive": true,
      "required": false
    },
    "mashov_semel": {
      "type": "string",
      "title": "Mashov School Code / סמל מוסד (optional)",
      "required": false
    },
    "webtop_username": {
      "type": "string",
      "title": "Webtop Username (optional)",
      "required": false
    },
    "webtop_password": {
      "type": "string",
      "title": "Webtop Password (optional)",
      "sensitive": true,
      "required": false
    }
  }
}
