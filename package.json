{
  "name": "il-school-mcp",
  "version": "0.2.1",
  "description": "Local-first MCP server and desktop plugin for Israeli school portals (Mashov & Webtop)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hagaija/il-school-mcp.git"
  },
  "homepage": "https://github.com/hagaija/il-school-mcp#readme",
  "bugs": {
    "url": "https://github.com/hagaija/il-school-mcp/issues"
  },
  "type": "module",
  "bin": {
    "il-school-mcp": "./dist/index.js"
  },
  "files": [
    "bundle",
    "dist",
    "scripts",
    "skills",
    "rules",
    "assets",
    ".agents",
    ".claude-plugin",
    ".antigravity-plugin",
    ".codex-plugin",
    ".mcp.json",
    "mcp.json",
    "mcp_config.json",
    "plugin.json",
    "manifest.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run build:bundle",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bundle/server.cjs",
    "pack:mcpb": "npm run build && rm -f il-school-mcp.mcpb && npx --yes @anthropic-ai/mcpb pack . il-school-mcp.mcpb",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "mammoth": "^1.8.0",
    "node-ical": "^0.18.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
